{
  "version": 1,
  "org": "Northwind Robotics",
  "departments": [
    "support",
    "docs",
    "growth",
    "engineering"
  ],
  "vars": {
    "root": "./repo"
  },
  "today": "2026-08-20",
  "roster": {
    "members": {
      "path": "{{root}}/roster.json",
      "pointer": "/agents"
    },
    "keywords": {
      "path": "{{root}}/roster.json",
      "pointer": "/routes"
    }
  },
  "requires": [
    "name",
    "role",
    "department",
    "owns",
    "description",
    "keywords",
    "model",
    "tools.allow",
    "inputs",
    "outputs",
    "nevers",
    "qa",
    "escalation",
    "unattended",
    "metric",
    "decommission"
  ],
  "jobDoc": {
    "surface": "job-doc",
    "requiredSections": [
      "Desk:",
      "Runtime:",
      "Job:",
      "Routed when",
      "Boundaries"
    ]
  },
  "surfaces": [
    {
      "id": "job-doc",
      "op": "file-from-template",
      "path": "{{root}}/docs/team/{{name}}.md",
      "template": "job-doc.md"
    },
    {
      "id": "subagent",
      "op": "file-from-template",
      "path": "{{root}}/.claude/agents/{{name}}.md",
      "template": "subagent.md"
    },
    {
      "id": "roster-member",
      "op": "json-set",
      "path": "{{root}}/roster.json",
      "pointer": "/agents/-",
      "value": "{{name}}"
    },
    {
      "id": "roster-route",
      "op": "json-set",
      "path": "{{root}}/roster.json",
      "pointer": "/routes/{{name}}",
      "value": {
        "label": "{{label}}",
        "skill": "{{name}}",
        "keywords": "{{keywords}}"
      }
    },
    {
      "id": "readme-row",
      "op": "line-insert",
      "path": "{{root}}/README.md",
      "anchor": "^\\| [A-Z].* \\|",
      "last": true,
      "skipIf": "^\\| {{Name}} \\|",
      "line": "| {{Name}} | {{owns}} | {{qa}} |"
    },
    {
      "id": "motor",
      "op": "file-from-template",
      "path": "{{root}}/motors/{{name}}.py",
      "template": "motor.py",
      "required": false,
      "when": "motor"
    }
  ],
  "guards": [
    {
      "id": "route-parity",
      "type": "set-equality",
      "a": {
        "path": "{{root}}/roster.json",
        "pointer": "/agents",
        "kind": "array"
      },
      "b": {
        "path": "{{root}}/roster.json",
        "pointer": "/routes",
        "kind": "keys"
      },
      "message": "an agent listed in /agents with no matching /routes entry breaks routing for the whole roster"
    }
  ],
  "verify": [
    "node -e \"const r=require('{{root}}/roster.json');if(!r.agents.includes('{{name}}'))process.exit(1);if(!r.routes['{{name}}'])process.exit(1);console.log('{{name}} present in agents and routes')\""
  ]
}
